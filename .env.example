# KeeperHub organization API key (kh_ prefix). Create at app.keeperhub.com under
# Settings > API Keys > Organisation tab.
KEEPERHUB_API_KEY=

# Sepolia RPC (public default works fine for reads; override if you have your own).
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# The Aave V3 (Sepolia) position(s) Bulwark watches, comma-separated.
MONITORED_ADDRESSES=

# Health factor threshold that triggers a protective repay.
HF_THRESHOLD=1.2

# Health factor a trigger repays enough debt to reach, computed per position from its
# real current HF and debt, not a fixed USDC amount. Must be greater than HF_THRESHOLD.
HF_TARGET=1.5

# Optional safety cap: max USDC a single trigger will ever repay, regardless of what the
# sizing math computes. Leave unset for no cap.
MAX_REPAY_USDC=300

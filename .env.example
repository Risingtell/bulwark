# KeeperHub organization API key (kh_ prefix). Create at app.keeperhub.com under
# Settings > API Keys > Organisation tab.
KEEPERHUB_API_KEY=

# Sepolia RPC (public default works fine for reads; override if you have your own).
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com

# The Aave V3 (Sepolia) position Bulwark watches.
MONITORED_ADDRESS=

# Health factor threshold that triggers a protective repay.
HF_THRESHOLD=1.2

# How much test USDC to repay per trigger (6 decimals handled in code — pass a plain number, e.g. 50).
REPAY_AMOUNT_USDC=50
